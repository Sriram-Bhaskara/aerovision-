# ===== SERVER =====
PORT=5000
NODE_ENV=development

# ===== DATABASE (SQLite — no setup needed) =====
DATABASE_PATH=./database/aerovision.db

# ===== JWT =====
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# ===== API KEYS =====
# AeroDataBox via RapidAPI — Free tier: 500 calls/month
AERODATABOX_API_KEY=your_aerodatabox_api_key

# OpenSky Network — Free account at https://opensky-network.org/
OPENSKY_USERNAME=your_opensky_username
OPENSKY_PASSWORD=your_opensky_password

# OpenWeather — Get free key at https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key

# Google Gemini — Free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# OpenRouter — Free key at https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# HuggingFace — Free token at https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_api_key

# OpenRouteService — Free key at https://openrouteservice.org/
OPENROUTESERVICE_API_KEY=your_openrouteservice_api_key

# ===== CORS =====
FRONTEND_URL=http://localhost:5173

# ===== DEFAULT AIRPORT =====
DEFAULT_AIRPORT_IATA=BLR
DEFAULT_AIRPORT_ICAO=VOBL
DEFAULT_AIRPORT_LAT=13.1986
DEFAULT_AIRPORT_LNG=77.7066
